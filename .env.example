# ===================================================
# CONFIGURAÇÕES DO SERVIDOR & PLATAFORMA
# ===================================================
PORT=3000
NODE_ENV=development
API_BASE_URL=http://localhost:3000

# ===================================================
# OPENAI & IA
# ===================================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ===================================================
# SUPABASE / BANCO DE DADOS (MULTI-TENANT)
# ===================================================
# IMPORTANTE: Nunca aponte para bancos de produção protegidos!
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===================================================
# AUTOMAÇÃO n8n (LOCAL OU VPS)
# ===================================================
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/omnichannel-agent
N8N_API_KEY=your_n8n_api_key_optional

# ===================================================
# CANAIS DE MENSAGERIA & WEBHOOKS
# ===================================================
# WhatsApp Business Platform / Cloud API
WHATSAPP_VERIFY_TOKEN=your_whatsapp_verify_token
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Instagram Messaging API
INSTAGRAM_VERIFY_TOKEN=your_instagram_verify_token
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token

# Facebook Messenger API
FACEBOOK_VERIFY_TOKEN=your_facebook_verify_token
FACEBOOK_ACCESS_TOKEN=your_facebook_access_token

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
